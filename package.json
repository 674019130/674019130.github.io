{
  "name": "valaxy-blog",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "activity:github": "node scripts/sync-activity.mjs --source=github",
    "activity:tokdash": "node scripts/sync-activity.mjs --source=tokdash",
    "projects:github": "node scripts/sync-projects.mjs",
    "build": "npm run build:ssg",
    "build:spa": "valaxy build",
    "build:ssg": "valaxy build --ssg",
    "dev": "valaxy",
    "rss": "valaxy rss",
    "serve": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "prebuild:ssg": "node scripts/sync-writing-dates.mjs",
    "prebuild:spa": "node scripts/sync-writing-dates.mjs",
    "predev": "node scripts/sync-writing-dates.mjs",
    "weekly:collect": "python3 scripts/weekly.py collect",
    "weekly:generate": "python3 scripts/weekly.py generate",
    "test:weekly": "python3 -m unittest discover -s tests -p test_weekly.py"
  },
  "dependencies": {
    "@waline/client": "3.4.1",
    "valaxy": "1.0.0-rc.12",
    "valaxy-addon-bangumi": "^0.4.0",
    "valaxy-addon-components": "^0.1.0",
    "valaxy-addon-lightgallery": "^0.0.4",
    "valaxy-addon-twikoo": "^0.0.4",
    "valaxy-addon-waline": "^0.2.1",
    "valaxy-theme-yun": "1.0.0-rc.12",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
